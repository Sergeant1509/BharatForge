# ==========================================
# BharatForge Backend - Git Ignore
# ==========================================

# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Build output
dist/
build/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# Local development files
*.local

# Database / local data
*.sqlite
*.sqlite3
*.db

# Debug files
.nodemon.json

# Certificates / private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Backup files
*.bak
*.backup
*~

# ==========================================
# End
